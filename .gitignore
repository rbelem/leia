# store packages are rebuilt per submission (see store/README.md)
store/pkg/*.zip
.audit/
store/pkg/*.sha256

# Per-tool copies of the agent skills: ten mirrors of the same 148 files
# (1.5k files, ~27 MB, 8x src) duplicated every search result and inflated the
# code index. Scoped to the mirror, not the whole dot-directory, so a tool's
# real project config stays trackable. The copies stay on disk for whichever
# tool reads them.
*/skills/impeccable/
.claude/settings.local.json
# Analysis output, not source: .impeccable/config.json and design.json stay.
.impeccable/critique/

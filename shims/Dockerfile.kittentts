# leia local-model shim — KittenTTS ONNX (Apache-2.0).
# NANO is the shipped default: kittentts==0.1.3 takes local onnx/voices
# paths and only understands nano's style layout (mini 0.8 needs the
# separate 0.8.0 GitHub wheel + misaki>=0.9.4 — not shipped).
# Model downloads into /root/.cache on first start — mount a volume.
FROM python:3.11-slim
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends espeak-ng \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir fastapi uvicorn kittentts==0.1.3
COPY server.py adapters.py ./
ENV KITTEN_MODEL=KittenML/kitten-tts-nano-0.1
EXPOSE 8882
CMD ["python", "server.py", "--model", "kittentts", "--host", "0.0.0.0", "--port", "8882"]
